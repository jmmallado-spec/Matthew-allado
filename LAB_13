<?php
// LAB 13: Simple Calculator

$num1 = 10;
$num2 = 5;
$operator = "+";

switch ($operator) {
    case "+":
        echo $num1 + $num2;
        break;
    case "-":
        echo $num1 - $num2;
        break;
    case "*":
        echo $num1 * $num2;
        break;
    case "/":
        echo $num1 / $num2;
        break;
    default:
        echo "Invalid Operator";
}
?>
